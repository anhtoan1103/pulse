# Copy file này thành .env và điền giá trị thật.
# KHÔNG commit file .env thật lên Git.

# --- Database ---
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=                      # random string dài, generate bằng: openssl rand -hex 32
JWT_EXPIRY_HOURS=24

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.pulse.toan.uk/api/v1/auth/oauth/google/callback

# --- OAuth: GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.pulse.toan.uk/api/v1/auth/oauth/github/callback

# --- AI Provider (chọn 1, ưu tiên free tier) ---
AI_PROVIDER=gemini                # gemini | groq
# Empty = AI analysis disabled (incidents are still opened, stay "pending").
AI_API_KEY=
AI_MODEL=gemini-1.5-flash         # đổi theo model thật của provider đã chọn
# Optional: any OpenAI-compatible base URL (up to, not including,
# /chat/completions). Overrides the default for AI_PROVIDER.
AI_BASE_URL=

# --- Email notification ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@toan.uk
# tls (port 465) | starttls (587, never falls back to plaintext) | none (local dev
# relay like Mailpit only). Default: tls for 465, otherwise starttls.
# Empty SMTP_HOST = email disabled (notifications stay pending).
SMTP_TLS=

# --- App ---
APP_ENV=development                # development | production
# The dashboard's own origin — the API's CORS policy allows exactly this one
# and no other (never *). Must match exactly what the browser bar shows for
# the frontend, e.g. http://localhost:3000 for local dev,
# https://pulse.toan.uk in production — no trailing slash, no path.
FRONTEND_URL=https://pulse.toan.uk
API_URL=https://api.pulse.toan.uk
# Header with the real client IP, used for auth rate limiting. Set to
# CF-Connecting-IP when the API is reachable ONLY via Cloudflare Tunnel;
# leave empty for local dev (uses the TCP peer address). If set while the API
# is also directly reachable, clients can spoof it to dodge rate limits.
CLIENT_IP_HEADER=

# --- Admin seed (dùng lúc migration đầu tiên) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=               # đổi ngay sau lần login đầu tiên
